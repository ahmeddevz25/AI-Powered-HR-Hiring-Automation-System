# Google Gemini API Configuration
# Get a free API key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# PostgreSQL Database Configuration (Primary)
# Automatically creates 'hr_automation' database if PostgreSQL is running on localhost:5432
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/hr_automation

# Privacy & Retention Settings
DATA_RETENTION_DAYS=90
MAX_UPLOAD_SIZE_MB=10
MAX_CALL_RETRY_ATTEMPTS=2
