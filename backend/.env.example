# Google Gemini API Configuration
# Get a free API key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# PostgreSQL Database Configuration (Primary)
# Automatically creates 'hr_automation' database if PostgreSQL is running on localhost:5432
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/hr_automation

# Privacy & Retention Settings
DATA_RETENTION_DAYS=90
MAX_UPLOAD_SIZE_MB=10
MAX_CALL_RETRY_ATTEMPTS=2

# Mailtrap / SMTP Email Configuration
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASSWORD=your_mailtrap_password
SMTP_FROM_EMAIL=recruiting@talentsense.ai

# ElevenLabs Voice AI Configuration (Plays directly inside Browser)
# Get API Key from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
